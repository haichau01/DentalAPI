# Copy to .env and change the values. .env is git-ignored and must never be committed.
# SQL Server requires 8+ characters with upper case, lower case, digits and symbols.
# Do not use ";" because the password is inserted into a connection string.
SA_PASSWORD=Change_Me_Str0ng!

# Key that signs access tokens: at least 32 random bytes. Generate one per environment, e.g. in Git Bash:
#   openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-random-value-of-at-least-32-bytes

# The first admin account, created on startup when no admin exists. Password: at least 12 characters.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Change_Me_Admin_Passw0rd
